# ─── Server Configuration ─────────────────────────────────────
PORT=5000
NODE_ENV=production
FRONTEND_PORT=80

# ─── MongoDB Atlas ────────────────────────────────────────────
# Replace with your actual MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxx.mongodb.net/vazraa?retryWrites=true&w=majority

# ─── Security ─────────────────────────────────────────────────
# Critical: Change this to a random, long, secure string in production
JWT_SECRET=production_super_secure_jwt_secret_key_change_me
JWT_EXPIRES_IN=7d
CORS_ORIGIN=http://localhost

# ─── Seed Configuration ───────────────────────────────────────
ADMIN_EMAIL=admin@vazraa.com
ADMIN_PASSWORD=ChangeThisPasswordInProd123!
ADMIN_NAME=Vazraa Admin

# ─── Third-Party APIs ─────────────────────────────────────────
AISENSY_API_KEY=your_production_aisensy_api_key_here
AISENSY_BASE_URL=https://backend.aisensy.com/campaign/t1/api/v2

# ─── Chat Session Timeout ─────────────────────────────────────
SESSION_TIMEOUT_MINUTES=30
