# ─── Server ───────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ─── MongoDB ──────────────────────────────────────────────
# Local:  mongodb://localhost:27017/vazraa
# Atlas:  mongodb+srv://<user>:<pass>@cluster.mongodb.net/vazraa
MONGODB_URI=mongodb://localhost:27017/vazraa

# ─── JWT ──────────────────────────────────────────────────
JWT_SECRET=vazraa_super_secret_jwt_key_change_in_production
JWT_EXPIRES_IN=7d

# ─── CORS ─────────────────────────────────────────────────
# Use * for local HTML file testing, or set your frontend origin
CORS_ORIGIN=*

# ─── AI Sensy ─────────────────────────────────────────────
AISENSY_API_KEY=your_aisensy_api_key_here
AISENSY_BASE_URL=https://backend.aisensy.com/campaign/t1/api/v2

# ─── Admin Seed ───────────────────────────────────────────
ADMIN_EMAIL=admin@vazraa.com
ADMIN_PASSWORD=Admin@1234
ADMIN_NAME=Vazraa Admin

# ─── Chat Session ─────────────────────────────────────────
# Minutes of inactivity before a chatbot session expires
SESSION_TIMEOUT_MINUTES=30
