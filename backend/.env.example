# ─── Server ───────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ─── MongoDB ──────────────────────────────────────────────
# Local:  mongodb://localhost:27017/vazraa
# Atlas:  mongodb+srv://<user>:<pass>@cluster.mongodb.net/vazraa
MONGODB_URI=mongodb://localhost:27017/vazraa

# ─── JWT ──────────────────────────────────────────────────
JWT_SECRET=vazraa_super_secret_jwt_key_change_in_production
JWT_EXPIRES_IN=7d

# ─── CORS ─────────────────────────────────────────────────
# Use * for local HTML file testing, or set your frontend origin
CORS_ORIGIN=*

# ─── AI Sensy ─────────────────────────────────────────────
AISENSY_API_KEY=your_aisensy_api_key_here
AISENSY_BASE_URL=https://backend.aisensy.com/campaign/t1/api/v2

# ─── Admin Seed ───────────────────────────────────────────
ADMIN_EMAIL=admin@vazraa.com
ADMIN_PASSWORD=Admin@1234
ADMIN_NAME=Vazraa Admin

# ─── Chat Session ─────────────────────────────────────────
# Minutes of inactivity before a chatbot session expires
SESSION_TIMEOUT_MINUTES=30

# ─── Cashfree Payment Gateway ─────────────────────────────────────────────────
# Get these from https://merchant.cashfree.com → Developers → API Keys
# Use SANDBOX keys for testing, PRODUCTION keys for live payments

# Your Cashfree App ID (safe to use in API calls, NOT in frontend code)
CASHFREE_CLIENT_ID=

# Your Cashfree Secret Key — NEVER expose this in frontend code or commit to Git
CASHFREE_CLIENT_SECRET=

# "sandbox" for testing, "production" for live payments
CASHFREE_ENV=sandbox

# Cashfree API version — use the latest recommended version
CASHFREE_API_VERSION=2025-01-01

# The full URL of your payment-result.html page (Cashfree redirects here after payment)
# For local testing: http://localhost:5000/payment-result.html
# For Docker/production: https://yourdomain.com/payment-result.html
CASHFREE_RETURN_URL=http://localhost:5000/payment-result.html

# Optional: Cashfree will POST payment events to this URL (for reliable updates)
# Must be a publicly accessible HTTPS URL (use ngrok for local testing)
CASHFREE_WEBHOOK_URL=
